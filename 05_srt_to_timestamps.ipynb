   "source": [
    "# 清洗错误时间戳\n",
    "\n",
    "import sqlite3\n",
    "\n",
    "DB_PATH = \"db/bible.db\"\n",
    "\n",
    "conn = sqlite3.connect(DB_PATH)\n",
    "cursor = conn.cursor()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "    UPDATE words\n",
    "    SET start_time = NULL, end_time = NULL\n",
    "    WHERE verse_id LIKE 'Mt.1.%'\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "conn.close()\n",
    "\n",
    "print(\"✅ Mt.1 旧时间戳已清除\")"
   ]
  },
